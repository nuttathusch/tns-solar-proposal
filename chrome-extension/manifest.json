{
  "manifest_version": 3,
  "name": "TNS SolarEdge 1-Click Sync",
  "version": "1.2.0",
  "description": "ดึงภาพ Screenshot + สเปก kWp / แผง / MWh จาก SolarEdge Designer เข้า TNS Solar Proposal Studio ใน 1 คลิก",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://designer.solaredge.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
